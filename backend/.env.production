# Server Configuration for O2Switch Production
PORT=8000
NODE_ENV=production
LOG_LEVEL=info

# Database (MongoDB Atlas)
MONGO_URI=your_mongodb_uri

# AI Service (Groq)
GROQ_API_KEY=your_groq_api_key

# Authentication (Generate strong random secrets)
JWT_SECRET=your_jwt_secret_min_32_characters
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters

# CORS - IMPORTANT: Must include your frontend domain!
WHITELIST_ORIGINS=https://gpdev.org,https://backend.gpdev.org
