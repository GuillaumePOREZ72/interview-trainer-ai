# Server Configuration
PORT=8000
NODE_ENV=production
LOG_LEVEL=info

# Database
MONGO_URI=your_mongodb_uri

# AI Service (Groq)
GROQ_API_KEY=your_groq_api_key

# Authentication (Generate strong random secrets)
JWT_SECRET=your_jwt_secret_min_32_characters
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters

# CORS - Comma-separated list of allowed origins
WHITELIST_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Email Configuration (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@interviewtrainer.ai

# Frontend URL (For reset links)
CLIENT_URL=http://localhost:5173
